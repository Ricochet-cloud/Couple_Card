+  animation: muzanBeat 2.4s ease-in-out infinite;
+}
+.card[data-theme="muzan"] .card__body {
+  background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255, 40, 40, 0.05) 3px 4px), #0c0103;
+}
+.card[data-theme="muzan"] .card__title { color: #ff5252; text-shadow: 0 0 8px rgba(255, 30, 30, 0.7), 0 1px 0 #000; }
+.card[data-theme="muzan"] .card__desc { color: #d9a3a3; }
+.card[data-theme="muzan"] .card__meta { color: #b57a7a; border-top: 2px dotted rgba(255, 60, 60, 0.4); }
+.card[data-theme="muzan"] .card__badge {
+  color: #ff5252; background: #120103; letter-spacing: 0.12em;
+  box-shadow: inset 0 0 0 1px #7a0c14, 0 0 6px rgba(255, 30, 30, 0.5);
+}
+.card[data-theme="muzan"] .card__badge::before { background: #ff2a2a; box-shadow: 0 0 6px #ff2a2a; }
+.card[data-theme="muzan"] .card__no { background: #120103; color: #ff8a8a; box-shadow: inset 0 0 0 1px #7a0c14; }
+.tilt[data-theme="muzan"] .card__in::after {
+  background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255, 70, 60, 0.55), transparent 52%);
+  mix-blend-mode: screen;
+}
+
+/* 아주 작은 칸(관리자 목록·도전과제·이벤트 칸)에서는 바깥 가시 고리를 숨겨요 */
+.cards-grid .card[data-theme="muzan"]::after,
+.ach-slot .card[data-theme="muzan"]::after,
+.event-slot .card[data-theme="muzan"]::after { display: none; }
+
+@keyframes muzanBeat {
+  0%, 100% { opacity: 0.7; }
+  14% { opacity: 1; }
+  28% { opacity: 0.75; }
+  42% { opacity: 1; }
+  70% { opacity: 0.7; }
+}
+@keyframes muzanWrithe {
+  0%, 100% { transform: scale(1) rotate(0deg); }
+  50% { transform: scale(1.018) rotate(0.5deg); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .card[data-theme="muzan"]::before,
+  .card[data-theme="muzan"]::after,
+  .card[data-theme="muzan"] .card__photo::before { animation: none; }
+}
