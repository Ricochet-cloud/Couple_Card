+    radial-gradient(ellipse 75% 70% at 50% 45%, transparent 50%, rgba(110, 0, 8, 0.6) 100%);
+  animation: muzanBeat 2.4s ease-in-out infinite;
+}
+.card[data-theme="muzan"] .card__photo::after {
+  box-shadow: inset 0 -2px 0 #120103, inset 0 -5px 0 #5a0711, inset 0 -6px 0 #c4161f;
+}
