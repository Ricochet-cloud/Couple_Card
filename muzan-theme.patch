diff --git a/css/card.css b/css/card.css
index a9d9d5f..0674b7a 100644
--- a/css/card.css
+++ b/css/card.css
@@ -665,3 +665,85 @@
   .card.card--wobble,
   .card.card--wobble .card__in { animation: none; }
 }
+
+/* ===== 카드 특수 디자인: 무잔 (카드 데이터 theme: 'muzan') =====
+   가시 돋은 촉수 + 핏방울 + 카드 밖으로 삐져나온 가시 고리. 히든 등급 위에 얹어서 써요. */
+.card[data-theme="muzan"] {
+  --f-dark: #120103; --f-shade: #3a0509; --f-mid: #7a0c14; --f-base: #2b0407; --f-light: #c4161f; --f-hi: #ffd6d6;
+  --gem: #ff2a2a;
+  --glow: 0 0 16px rgba(255, 30, 30, 0.45), 0 0 34px rgba(150, 0, 10, 0.45);
+  animation: none;
+  overflow: visible;
+}
+.card[data-theme="muzan"] .card__in { background: #0c0103; animation: none; }
+.card[data-theme="muzan"] .card__in::before { display: none; }   /* 히든의 푸른 안개는 끔 */
+
+/* 사진 자리: 피로 물든 밤 + 붉은 달 */
+.card[data-theme="muzan"] .card__photo {
+  background:
+    radial-gradient(circle at 72% 26%, rgba(255, 120, 110, 0.75) 0 8%, rgba(255, 40, 40, 0.25) 9% 16%, transparent 17%),
+    radial-gradient(ellipse at 50% 120%, #5d0710 0, transparent 65%),
+    linear-gradient(170deg, #2a0409, #0b0103);
+}
+/* 핏빛 비네트 + 핏방울 (심장처럼 두근) */
+.card[data-theme="muzan"] .card__photo::before {
+  content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; mix-blend-mode: normal;
