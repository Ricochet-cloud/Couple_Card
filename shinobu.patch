+}
+.card[data-theme="shinobu"] .card__body {
+  background: linear-gradient(180deg, #1f1538, #2a1a4a);
+}
+.card[data-theme="shinobu"] .card__title { color: #e6d8ff; text-shadow: 0 0 8px rgba(170, 120, 250, 0.7), 0 1px 0 #000; }
+.card[data-theme="shinobu"] .card__desc { color: #bba9e3; }
+.card[data-theme="shinobu"] .card__meta { color: #9a88c4; border-top: 2px dotted rgba(184, 150, 240, 0.45); }
+.card[data-theme="shinobu"] .card__badge {
+  color: #e6d8ff; background: #150d28; letter-spacing: 0.1em;
+  box-shadow: inset 0 0 0 1px #8a62c9, 0 0 6px rgba(170, 120, 250, 0.55);
+}
+.card[data-theme="shinobu"] .card__badge::before { background: #c9a6ff; box-shadow: 0 0 6px #b58cf0; }
+.card[data-theme="shinobu"] .card__no { background: #150d28; color: #d6c2ff; box-shadow: inset 0 0 0 1px #8a62c9; }
+.tilt[data-theme="shinobu"] .card__in::after {
+  background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(215, 190, 255, 0.5), transparent 52%);
+  mix-blend-mode: screen;
+}
+
+/* 작은 칸에서는 바깥 등꽃을 숨기고, 관리자 목록(칸이 많아요)에서는 나비도 숨겨요 */
+.cards-grid .card[data-theme="shinobu"]::after,
+.ach-slot .card[data-theme="shinobu"]::after,
+.event-slot .card[data-theme="shinobu"]::after,
+.cards-grid .card[data-theme="shinobu"]::before { display: none; }
+.cards-grid .card[data-theme="shinobu"] .card__in::before,
+.ach-slot .card[data-theme="shinobu"] .card__in::before,
+.event-slot .card[data-theme="shinobu"] .card__in::before { animation: none; }
+
+@keyframes shinobuFog {
+  from { transform: translateX(-4%); opacity: 0.65; }
+  to   { transform: translateX(4%);  opacity: 1; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .card[data-theme="shinobu"] .card__in::before { animation: none; }
+}
-- 
