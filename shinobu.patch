diff --git a/admin.html b/admin.html
index d921bf4..27146a5 100644
--- a/admin.html
+++ b/admin.html
@@ -92,6 +92,7 @@
                 <option value="">없음 (등급 디자인 그대로)</option>
                 <option value="muzan">무잔 — 핏빛 가시 촉수</option>
                 <option value="mitsuri">미츠리 — 벚꽃 흩날림</option>
+                <option value="shinobu">시노부 — 등꽃과 나비</option>
               </select>
             </div>
 
diff --git a/css/card.css b/css/card.css
index 1fe5762..5bbf5f7 100644
--- a/css/card.css
+++ b/css/card.css
@@ -861,3 +861,78 @@
   .card[data-theme="mitsuri"] .card__in::before,
   .card[data-theme="mitsuri"] .card__photo::before { animation: none; top: 0; height: 100%; background-size: 100% 100%; }
 }
+
+/* ===== 카드 특수 디자인: 시노부 (카드 데이터 theme: 'shinobu') =====
+   위에서 늘어진 등꽃(살랑살랑 + 꽃잎), 아래에서 날갯짓하는 나비 6마리, 카드 전체에 은은한 보라 안개. 영웅 등급 위에 얹어서 써요. */
+.card[data-theme="shinobu"] {
+  --f-dark: #2a1647; --f-shade: #5b3a8c; --f-mid: #8a62c9; --f-base: #b79af0; --f-light: #dccbff; --f-hi: #f6f0ff;
+  --gem: #e8c8ff;
+  --glow: 0 0 14px rgba(160, 110, 240, 0.55), 0 0 30px rgba(120, 80, 210, 0.35);
+  overflow: visible;
+}
+.card[data-theme="shinobu"] .card__in { background: #1b1233; position: relative; }
+/* 사진 자리: 보랏빛 밤 + 달빛 */
+.card[data-theme="shinobu"] .card__photo {
+  background:
+    radial-gradient(circle at 74% 30%, rgba(255, 250, 255, 0.95) 0 6%, rgba(220, 200, 255, 0.4) 7% 14%, transparent 15%),
+    radial-gradient(ellipse at 50% 120%, #8a62c9 0, transparent 65%),
+    linear-gradient(170deg, #1d1238, #3c2670 60%, #5b3a8c);
+}
+.card[data-theme="shinobu"] .card__photo::after {
+  box-shadow: inset 0 -2px 0 #2a1647, inset 0 -5px 0 #dccbff, inset 0 -6px 0 #8a62c9;
+}
+/* 보라 안개 (카드 전체, 천천히 흘러요) */
+.card[data-theme="shinobu"] .card__in::before {
+  content: ''; position: absolute; z-index: 4; pointer-events: none;
+  left: -10%; top: 0; width: 120%; height: 100%;
+  background:
+    radial-gradient(ellipse 55% 30% at 22% 88%, rgba(170, 120, 250, 0.38), transparent 70%),
+    radial-gradient(ellipse 60% 32% at 78% 30%, rgba(200, 160, 255, 0.3), transparent 70%),
+    radial-gradient(ellipse 80% 40% at 50% 60%, rgba(130, 90, 215, 0.22), transparent 72%);
+  mix-blend-mode: screen;
+  animation: shinobuFog 9s ease-in-out infinite alternate;
+}
+/* 나비 */
+.card[data-theme="shinobu"]::before {
+  inset: 0; z-index: 6; pointer-events: none;
