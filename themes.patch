+  transform-origin: 50% 50%;
+  animation: mitsuriBloom 5s ease-in-out infinite;
+}
+.card[data-theme="mitsuri"] .card__body {
+  background: linear-gradient(180deg, #fff7f9, #ffe6ee);
+}
+.card[data-theme="mitsuri"] .card__title { color: #c2305f; text-shadow: 0 1px 0 #fff; }
+.card[data-theme="mitsuri"] .card__desc { color: #7a4358; }
+.card[data-theme="mitsuri"] .card__meta { color: #a0687c; border-top: 2px dotted rgba(232, 127, 166, 0.6); }
+.card[data-theme="mitsuri"] .card__badge {
+  color: #c2305f; background: #fff0f5; letter-spacing: 0.08em;
+  box-shadow: inset 0 0 0 1px #e87fa6, 0 0 6px rgba(255, 130, 175, 0.5);
+}
+.card[data-theme="mitsuri"] .card__badge::before { background: #ff7aa6; box-shadow: 0 0 6px #ff9ec2; }
+.card[data-theme="mitsuri"] .card__no { background: #fff0f5; color: #c2305f; box-shadow: inset 0 0 0 1px #e87fa6; }
+/* 기울이면 분홍빛 반사 */
+.tilt[data-theme="mitsuri"] .card__in::after {
+  background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255, 200, 225, 0.6), transparent 52%);
+  mix-blend-mode: screen;
+}
+
+/* 아주 작은 칸에서는 바깥 벚꽃 고리를 숨기고, 꽃잎은 멈춰요 */
+.cards-grid .card[data-theme="mitsuri"]::after,
+.ach-slot .card[data-theme="mitsuri"]::after,
+.event-slot .card[data-theme="mitsuri"]::after { display: none; }
+.cards-grid .card[data-theme="mitsuri"] .card__in::before,
+.cards-grid .card[data-theme="mitsuri"] .card__photo::before,
+.ach-slot .card[data-theme="mitsuri"] .card__in::before,
+.ach-slot .card[data-theme="mitsuri"] .card__photo::before,
+.event-slot .card[data-theme="mitsuri"] .card__in::before,
+.event-slot .card[data-theme="mitsuri"] .card__photo::before { animation: none; top: 0; height: 100%; background-size: 100% 100%; }
+
+@keyframes mitsuriFall {
+  from { transform: translateY(0); }
+  to   { transform: translateY(50%); }
+}
+@keyframes mitsuriSway {
+  from { translate: -3% 0; }
+  to   { translate: 3% 0; }
+}
+@keyframes mitsuriBloom {
+  0%, 100% { transform: scale(1);     filter: drop-shadow(0 0 3px rgba(255, 150, 190, 0.5)); }
+  50%      { transform: scale(1.012); filter: drop-shadow(0 0 7px rgba(255, 150, 190, 0.85)); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .card[data-theme="mitsuri"]::after,
+  .card[data-theme="mitsuri"] .card__in::before,
+  .card[data-theme="mitsuri"] .card__photo::before { animation: none; top: 0; height: 100%; background-size: 100% 100%; }
 }
