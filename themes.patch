diff --git a/admin.html b/admin.html
index ae82c49..d921bf4 100644
--- a/admin.html
+++ b/admin.html
@@ -91,6 +91,7 @@
               <select id="cardTheme">
                 <option value="">없음 (등급 디자인 그대로)</option>
                 <option value="muzan">무잔 — 핏빛 가시 촉수</option>
+                <option value="mitsuri">미츠리 — 벚꽃 흩날림</option>
               </select>
             </div>
 
diff --git a/css/card.css b/css/card.css
index 0674b7a..97f5f6f 100644
--- a/css/card.css
+++ b/css/card.css
@@ -667,7 +667,7 @@
 }
 
 /* ===== 카드 특수 디자인: 무잔 (카드 데이터 theme: 'muzan') =====
-   가시 돋은 촉수 + 핏방울 + 카드 밖으로 삐져나온 가시 고리. 히든 등급 위에 얹어서 써요. */
+   가시 돋은 촉수 + 카드 밖으로 삐져나온 가시 고리. 가장자리가 심장처럼 쿵-쿵 뛰어요. 히든 등급 위에 얹어서 써요. */
 .card[data-theme="muzan"] {
   --f-dark: #120103; --f-shade: #3a0509; --f-mid: #7a0c14; --f-base: #2b0407; --f-light: #c4161f; --f-hi: #ffd6d6;
   --gem: #ff2a2a;
@@ -675,8 +675,14 @@
   animation: none;
   overflow: visible;
 }
-.card[data-theme="muzan"] .card__in { background: #0c0103; animation: none; }
-.card[data-theme="muzan"] .card__in::before { display: none; }   /* 히든의 푸른 안개는 끔 */
+.card[data-theme="muzan"] .card__in { background: #0c0103; animation: none; position: relative; }
+/* 히든의 푸른 안개 대신: 안쪽 가장자리가 붉게 뛰는 심장박동 */
+.card[data-theme="muzan"] .card__in::before {
+  content: ''; position: absolute; inset: 0; z-index: 5; pointer-events: none;
+  background: none; mix-blend-mode: normal;
+  box-shadow: inset 0 0 12px 3px rgba(255, 24, 30, 0.9), inset 0 0 34px 8px rgba(160, 0, 12, 0.7);
+  animation: muzanEdge 1.8s ease-in-out infinite;
+}
 
 /* 사진 자리: 피로 물든 밤 + 붉은 달 */
 .card[data-theme="muzan"] .card__photo {
@@ -685,12 +691,11 @@
     radial-gradient(ellipse at 50% 120%, #5d0710 0, transparent 65%),
     linear-gradient(170deg, #2a0409, #0b0103);
 }
-/* 핏빛 비네트 + 핏방울 (심장처럼 두근) */
